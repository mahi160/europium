{
	skip_install_trust
	# Browsers send no SNI for IP addresses, and Docker NAT hides the host IP from Caddy.
	default_sni {$OFFICE_ADDRESS}
}

https://{$OFFICE_ADDRESS} {
	tls internal
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
